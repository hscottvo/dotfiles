# Visual
theme = Catppuccin Macchiato
background-opacity = 0.9
background-blur = true
font-family = FiraCode Nerd Font
font-size = 18

# Font size — current pane
keybind = super+shift+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size

# Font size — all panes
keybind = all:super+alt+shift+equal=increase_font_size:1
keybind = all:super+alt+minus=decrease_font_size:1
keybind = all:super+alt+0=reset_font_size

# Scrollback
scrollback-limit = 100000

# Searchable scrollback
clipboard-read = allow
clipboard-write = allow
keybind = super+c=copy_to_clipboard:plain
keybind = super+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+c=copy_to_clipboard:plain

# Splits
keybind = super+shift+enter=new_split:auto
window-save-state = "always"

# Move to splits
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_down=goto_split:down
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_right=goto_split:right
keybind = super+alt+h=goto_split:left
keybind = super+alt+j=goto_split:down
keybind = super+alt+k=goto_split:up
keybind = super+alt+l=goto_split:right

# Resize splits
keybind = super+ctrl+h=resize_split:left,10
keybind = super+ctrl+j=resize_split:down,10
keybind = super+ctrl+k=resize_split:up,10
keybind = super+ctrl+l=resize_split:right,10
keybind = super+ctrl+arrow_left=resize_split:left,10
keybind = super+ctrl+arrow_down=resize_split:down,10
keybind = super+ctrl+arrow_up=resize_split:up,10
keybind = super+ctrl+arrow_right=resize_split:right,10

# Split management
keybind = super+shift+z=toggle_split_zoom
keybind = super+shift+e=equalize_splits

# Tabs
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+alt+t=prompt_tab_title

# Prompt navigation
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1

# Shell Integration
shell-integration-features = ssh-env,ssh-terminfo

