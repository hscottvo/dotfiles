# Visual
font-family = FiraCode Nerd Font
font-size = 14

# Scrollback
scrollback-limit = 100000

# Searchable scrollback
clipboard-read = allow
clipboard-write = allow

# Splits
keybind = super+shift+enter=new_split:auto

# Move to splits: arrow keys mapped by default
keybind = super+shift+h=goto_split:left
keybind = super+shift+j=goto_split:down
keybind = super+shift+k=goto_split:up
keybind = super+shift+l=goto_split:right

# Resize splits
keybind = super+ctrl+h=resize_split:left,10
keybind = super+ctrl+j=resize_split:down,10
keybind = super+ctrl+k=resize_split:up,10
keybind = super+ctrl+l=resize_split:right,10

# Split management
keybind = super+shift+z=toggle_split_zoom
keybind = super+shift+e=equalize_splits

# Tabs
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+t=prompt_tab_title
keybind = super+shift+alt+left=previous_tab
keybind = super+shift+alt+right=next_tab
keybind = super+shift+alt+h=previous_tab
keybind = super+shift+alt+l=next_tab

# Prompt navigation
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1

# Shell Integration
shell-integration-features = ssh-env,ssh-terminfo
